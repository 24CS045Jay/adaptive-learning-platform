# ==============================================================================
# EDUSENSE AI AGENTIC RAG PLATFORM — SANITIZED ENVIRONMENT TEMPLATE
# Copy this file to .env (and optionally rag_service/.env) and populate your keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth (Mandatory for Express Backend & Frontend)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# JWT secret key for token verification
JWT_SECRET=your_jwt_secret_key_change_me_2026

# ------------------------------------------------------------------------------
# 2. Cloud Storage (Cloudinary - Optional for raw file hosting)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 3. LLM API Keys (At least one required: Gemini, Groq, or OpenAI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_optional

# ------------------------------------------------------------------------------
# 4. Agentic RAG Service Configuration
# ------------------------------------------------------------------------------
PORT=5000
SERVICE_PORT=8001
RAG_SERVICE_URL=http://localhost:8001
INTERNAL_SERVICE_TOKEN=your_secure_internal_service_token_here
CONFIDENCE_THRESHOLD=0.35

# LLM tier models
LLM_PROVIDER_ORDER=gemini,groq,openai
GEMINI_HEAVY_MODEL=gemini-3.8-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
GROQ_HEAVY_MODEL=qwen/qwen3.8-27b
GROQ_LIGHT_MODEL=openai/gpt-oss-20b
OPENAI_HEAVY_MODEL=gpt-4o-mini
OPENAI_LIGHT_MODEL=gpt-4o-mini

# Embedding Configuration
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 5. Chroma Vector Database (Chroma Cloud or Local)
# ------------------------------------------------------------------------------
# Sign up at https://cloud.trychroma.com to obtain these
CHROMA_API_KEY=your_chroma_cloud_api_key
CHROMA_TENANT=your_chroma_tenant_id
CHROMA_DATABASE=your_chroma_database_name

# Leave above 3 empty to fall back to local disk-persisted Chroma
CHROMA_LOCAL_DIR=./chroma_data
RAG_OFFLINE=0
NB_OFFLINE=0

# ------------------------------------------------------------------------------
# 6. Microsoft Teams Integration (Faculty Connect Online Meetings)
# ------------------------------------------------------------------------------
# Microsoft Entra (Azure AD) App Registration Credentials
# Requires Application Permission: OnlineMeetings.ReadWrite.All with Admin Consent
# Requires Teams Application Access Policy granted to MICROSOFT_ORGANIZER_USER_ID
MICROSOFT_TENANT_ID=your_microsoft_entra_tenant_id_here
MICROSOFT_CLIENT_ID=your_microsoft_entra_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_entra_client_secret_here
MICROSOFT_ORGANIZER_USER_ID=your_microsoft_organizer_user_object_id_here

# ------------------------------------------------------------------------------
# 7. AI Faculty Real-Time Voice & Video Services
# ------------------------------------------------------------------------------
# Sarvam AI (Speech-to-Text & Text-to-Speech for Gujarati, Hindi, English)
# Sign up at https://dashboard.sarvam.ai to obtain your subscription key
SARVAM_API_KEY=your_sarvam_api_subscription_key_here

# Tavus AI (Real-time Conversational Video Replica / WebRTC)
# Sign up at https://platform.tavus.io to obtain your API key
TAVUS_API_KEY=your_tavus_api_key_here
TAVUS_REPLICA_ID=r79e1c033f
TAVUS_PERSONA_ID=p9a8b7c6d5

# ------------------------------------------------------------------------------
# 8. Brevo Transactional Email Service (Over HTTPS API - Mandatory for Production)
# ------------------------------------------------------------------------------
# Create a free account at https://app.brevo.com
# Generate API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=verified_sender@yourdomain.com
BREVO_SENDER_NAME="Edusense AI"
FRONTEND_URL=https://your-frontend-app.vercel.app

# ------------------------------------------------------------------------------
# [OBSOLETE / DEPRECATED] Native SMTP (Blocked on Render and Serverless Hosts)
# ------------------------------------------------------------------------------
# These are no longer needed with Brevo API and can safely be removed from production:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_SERVICE_DRIVER=smtp



