# ==============================================================================
# University Agentic RAG Service — Environment Variables
# ==============================================================================

# Service Configuration
SERVICE_PORT=8001
DEBUG=false
LOG_LEVEL=INFO

# Internal Shared Secret with Express Backend
INTERNAL_SERVICE_TOKEN=univ-rag-internal-dev-token

# ── Primary LLM Provider: Google Gemini ──
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=2048

# ── Fallback LLM Provider: Groq ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048

# ── Optional Secondary Fallback: OpenAI ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Vector Store: Chroma Cloud (cloud.trychroma.com) ──
# Required for hosted production deployment. If left blank, uses local fallback.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_USE_LOCAL=false
CHROMA_LOCAL_PERSIST_DIR=./chroma_data

# ── Embeddings: BAAI/bge-m3 ──
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ── Reranker: Cross-Encoder ──
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Background Worker Queue (Redis / Celery) ──
REDIS_URL=redis://localhost:6379/0
