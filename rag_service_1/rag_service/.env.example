# ===== RAG SERVICE (copy to rag_service/.env OR keep in repo-root .env) =====
SERVICE_PORT=8001
INTERNAL_SERVICE_TOKEN=change-me-long-random-string

# ---- LLM keys (at least ONE required) ----
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Provider order tried for answers (first available wins, rest are fallbacks)
LLM_PROVIDER_ORDER=gemini,groq,openai
# Heavy model = answer generation / grounding check. Light model = routing, rewriting, grading.
GEMINI_HEAVY_MODEL=gemini-2.5-flash
GEMINI_LIGHT_MODEL=gemini-2.5-flash-lite
GROQ_HEAVY_MODEL=llama-3.3-70b-versatile
GROQ_LIGHT_MODEL=llama-3.1-8b-instant
OPENAI_HEAVY_MODEL=gpt-4o-mini
OPENAI_LIGHT_MODEL=gpt-4o-mini

# ---- Embeddings (choose ONE provider; changing it later needs re-ingestion) ----
# gemini | openai | local
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Chroma Cloud (https://trychroma.com) ----
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# Leave the 3 above empty to use a local on-disk Chroma instead
CHROMA_LOCAL_DIR=./chroma_data

# ---- Retrieval / agent tuning ----
CHUNK_SIZE=900
CHUNK_OVERLAP=150
DENSE_K=12
SPARSE_K=12
FINAL_K=5
MIN_RELEVANCE=0.15
MAX_RETRIEVAL_ROUNDS=2

# Test/offline mode: deterministic hash embeddings + rule-based mock LLM (NO API calls)
RAG_OFFLINE=0
